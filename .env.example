# ==============================================================================
# LifeDrop Frontend Environment Configuration (Vercel Deployment)
# ==============================================================================
# In production on Vercel, configure this in Project Settings > Environment Variables.
# It MUST point to your live Render Express API URL ending with /api/v1.
#
# Production Example:
# VITE_API_BASE_URL=https://lifedrop-api.onrender.com/api/v1
#
# Local Development Value:
VITE_API_BASE_URL=http://localhost:5001/api/v1
