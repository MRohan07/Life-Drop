# ==============================================================================
# LifeDrop Backend Environment Configuration (Render Web Service)
# ==============================================================================

# Server Environment & Port
# Set to 'production' on Render Web Service
NODE_ENV=development
# Render provides process.env.PORT automatically (typically 10000 on Render). Local fallback: 5001
PORT=5001

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection String
# ------------------------------------------------------------------------------
# For Local Development:
# DATABASE_URL="postgresql://lifedrop_user:lifedrop_secure_pass_2026@localhost:5432/lifedrop?schema=public"
#
# For Render Production:
# Use the "Internal Database URL" from your Render PostgreSQL dashboard:
# DATABASE_URL="postgresql://lifedrop_user:<password>@dpg-<id>-a.<region>-postgres.render.com/lifedrop?sslmode=require"
# Note: Keep lifedrop_test isolated for Vitest runs
DATABASE_URL="postgresql://lifedrop_user:lifedrop_secure_pass_2026@localhost:5432/lifedrop?schema=public"
TEST_DATABASE_URL="postgresql://lifedrop_user:lifedrop_secure_pass_2026@localhost:5432/lifedrop_test?schema=public"

# ------------------------------------------------------------------------------
# Frontend & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# FRONTEND_URL: The primary URL of your deployed Vercel frontend (without trailing slash)
# Example: https://lifedrop.vercel.app
FRONTEND_URL="http://localhost:3000"

# CORS_ORIGINS: Comma-separated list of additional allowed frontend origins
# Example: "https://lifedrop.vercel.app,https://lifedrop-rohan.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# JWT Access Secret: Generate a secure 64+ char random hex string for production
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="lifedrop_jwt_access_secret_key_production_replace_this_min_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh Token Life Span (days)
# Opaque tokens are persisted securely in the database and rotated on each refresh
REFRESH_TOKEN_EXPIRES_DAYS="7"

# Super Admin Initial Passkey PIN
# Used for initial administrator bootstrapping / elevation
ADMIN_PASSKEY_PIN="901234"

# ------------------------------------------------------------------------------
# Logging & External Integrations
# ------------------------------------------------------------------------------
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID="LIFEDROP"
LOG_LEVEL="info"
